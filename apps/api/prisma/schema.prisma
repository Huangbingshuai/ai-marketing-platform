generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum AssetDirectory {
  SOURCE_MATERIALS
  SOURCE_VIDEOS
  SCRIPTS
  PROMPTS
  VISUAL_ASSETS
  AUDIO_ASSETS
  VIDEO_MATERIALS
  SUBTITLES
  INSIGHTS
  EDITING_PROJECTS
  REPLACEMENT_PLANS
  REPLACEMENT_CONFIGS
  REPLACEMENT_REFERENCES
  ARCHIVES
  FINAL_VIDEOS
  REPORTS_DELIVERABLES
}

enum AssetType {
  DIGITAL_HUMAN_CHARACTER
  AVATAR_REFERENCE
  PERSON_ASSET
  PRODUCT_ASSET
  SCENE_BACKGROUND
  VISUAL_ASSET
  GENERIC_VIDEO
  REFERENCE_VIDEO
  SOURCE_VIDEO
  VIDEO_MATERIAL
  FINAL_VIDEO
  VOICE_AUDIO
  VOICE_PROFILE
  SUBTITLE
  PROMPT
  SCRIPT_COPY
  STORYBOARD_SCRIPT
  SOURCE_MATERIAL
  VIDEO_CONFIG
  INSIGHT_RESULT
  MIX_TEMPLATE
  TIMELINE_PROJECT
  EDITING_PROJECT
  ARCHIVE_DELIVERABLE
  REPLACEMENT_MAPPING
  REPLACEMENT_CONFIGURATION
  REFERENCE_SET
  DELIVERY_MANIFEST
  ANALYSIS_QUALITY_REPORT
}

enum AssetWorkflow {
  EFFECT
  CUSTOMIZED
  FISSION
}

enum AssetWorkflowSpace {
  EFFECT
  CUSTOMIZED_PROJECT
  CUSTOMIZED_VOICE_LIBRARY
  FISSION_CLONE
  FISSION_AVATAR
  FISSION_LOCAL_REPLACE
}

enum AssetStatus {
  AVAILABLE
  PENDING_REVIEW
  QUALITY_WARNING
  UNAVAILABLE
}

enum EffectImportMode {
  SINGLE
  BATCH
}

enum EffectImportDraftStatus {
  DRAFT
  VALID
  COMPLETED
}

enum EffectImportMaterialType {
  PRODUCT_IMAGE
  PRODUCT_DOCUMENT
  BRAND_GUIDELINE
  REFERENCE_VIDEO
}

enum EffectImportMaterialStatus {
  MISSING
  UPLOADING
  READY
  FAILED
}

enum EffectImportFailureDisposition {
  RETRYABLE
  REQUIRES_NEW_FILE
}

enum EffectManifestImportStatus {
  PREVIEW
  COMMITTED
  CANCELLED
  EXPIRED
}

enum EffectManifestFormat {
  csv
  xlsx
}

enum EffectManifestFileMatchStatus {
  MATCHED
  MISSING
  AMBIGUOUS
}

enum EffectExtractionRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EffectPromptOperation {
  BATCH_GENERATE
  ITEM_REGENERATE
}

enum EffectPromptRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum EffectPromptStageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  SKIPPED
  FAILED
}

enum EffectPromptQualityStatus {
  PASS
  NEEDS_REVIEW
}

enum WorkflowRunStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum WorkingArtifactKind {
  FILE
  STRUCTURED
}

enum WorkingArtifactFreshness {
  CURRENT
  STALE
}

enum WorkingArtifactAvailability {
  AVAILABLE
  SOURCE_REMOVED
  PENDING_DELETE
}

enum WorkingArtifactDependencySourceType {
  NODE_STATE
  WORKING_ARTIFACT
  EXECUTION_INPUT
}

enum EffectImportProductStatus {
  ACTIVE
  REMOVED
}

enum FileObjectStatus {
  AVAILABLE
  ORPHANED
}

enum EffectImportUploadSessionStatus {
  UPLOADING
  COMPLETED
  FAILED
  EXPIRED
}

enum EffectImportUploadItemStatus {
  PENDING
  UPLOADED
  FAILED
  REMOVED
}

enum EffectExtractionBranch {
  DOCUMENT
  IMAGE
  COMMERCE
  FORM
  FUSION
  NORMALIZATION
}

enum EffectExtractionBranchStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  SKIPPED
  FAILED
}

enum JobOutboxStatus {
  PENDING
  PUBLISHED
}

model Project {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(120)
  description                String?                     @db.VarChar(500)
  client                     String?                     @db.VarChar(120)
  productName                String?                     @db.VarChar(120)
  iconKey                    String?                     @db.VarChar(80)
  defaultWorkflow            AssetWorkflow?
  defaultSpace               AssetWorkflowSpace?
  status                     ProjectStatus               @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  assets                     Asset[]
  assetVersions              AssetVersion[]
  effectImportWorkspace      EffectImportWorkspace?
  assetOperationReceipts     AssetOperationReceipt[]
  storageCleanupTasks        StorageCleanupTask[]
  effectExtractionRuns       EffectExtractionRun[]
  effectExtractionResults    EffectExtractionResult[]
  effectPromptRuns           EffectPromptRun[]
  effectPromptResults        EffectPromptResult[]
  jobOutboxEntries           JobOutbox[]
  effectExtractionFileHolds  EffectExtractionFileHold[]
  workflowRuns               WorkflowRun[]
  workflowNodeStates         WorkflowNodeState[]
  workingArtifacts           WorkingArtifact[]
  fileObjects                FileObject[]
  effectImportUploadSessions EffectImportUploadSession[]

  @@index([updatedAt])
  @@map("projects")
}

model Asset {
  id               String             @id @default(uuid()) @db.Uuid
  projectId        String             @db.Uuid
  name             String             @db.VarChar(120)
  directory        AssetDirectory
  type             AssetType
  storageWorkflow  AssetWorkflow      @default(EFFECT)
  workflowSpace    AssetWorkflowSpace @default(EFFECT)
  status           AssetStatus        @default(AVAILABLE)
  qualityStatus    AssetStatus        @default(AVAILABLE)
  currentVersion   Int                @default(1)
  tags             String[]           @default([])
  notes            String?            @db.VarChar(2000)
  originalFileName String             @db.VarChar(255)
  mimeType         String             @db.VarChar(120)
  sizeBytes        Int
  storageKey       String             @db.VarChar(500)
  hasFile          Boolean            @default(true)
  assetClass       String?            @db.VarChar(120)
  businessType     String?            @db.VarChar(160)
  contentKind      String?            @db.VarChar(160)
  content          Json?
  businessData     Json?
  views            String[]           @default([])
  sourceArtifactId String?            @db.VarChar(255)
  sourceRunId      String?            @db.VarChar(255)
  sourceNode       String?            @db.VarChar(255)
  sourceShot       String?            @db.VarChar(255)
  idempotencyKey   String?            @db.VarChar(500)
  sourceProjectId  String?            @db.Uuid
  sourceAssetId    String?            @db.Uuid
  sourceVersion    Int?
  importedAt       DateTime?
  dependencies     Json?
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions         AssetVersion[]

  @@unique([projectId, storageWorkflow, workflowSpace, idempotencyKey], map: "assets_project_workflow_space_idempotency_key")
  @@index([projectId, archivedAt, updatedAt])
  @@index([projectId, directory, type, archivedAt])
  @@index([projectId, storageWorkflow, workflowSpace, archivedAt])
  @@map("assets")
}

model WorkflowRun {
  id                         String                      @id @default(uuid()) @db.Uuid
  projectId                  String                      @db.Uuid
  workflow                   AssetWorkflow
  workflowSpace              AssetWorkflowSpace
  status                     WorkflowRunStatus           @default(ACTIVE)
  activeKey                  String?                     @default("ACTIVE") @db.VarChar(32)
  currentNodeId              String?                     @db.VarChar(160)
  lastActiveAt               DateTime                    @default(now())
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  completedAt                DateTime?
  project                    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeStates                 WorkflowNodeState[]
  workingArtifacts           WorkingArtifact[]
  fileObjects                FileObject[]
  effectImportUploadSessions EffectImportUploadSession[]
  effectWorkspace            EffectImportWorkspace?
  effectImportProducts       EffectImportProduct[]
  effectImportMaterials      EffectImportMaterial[]
  effectImportUploadItems    EffectImportUploadItem[]
  effectPromptRuns           EffectPromptRun[]
  effectPromptResults        EffectPromptResult[]

  @@unique([projectId, workflow, workflowSpace, activeKey])
  @@unique([projectId, id])
  @@index([projectId, workflow, workflowSpace, status])
  @@map("workflow_runs")
}

model WorkflowNodeState {
  id                          String      @id @default(uuid()) @db.Uuid
  projectId                   String      @db.Uuid
  workflowRunId               String      @db.Uuid
  nodeId                      String      @db.VarChar(160)
  schemaVersion               Int         @default(1)
  revision                    Int         @default(1)
  contentHash                 String      @db.Char(64)
  executionInputHash          String      @default("0e9561cfb83d50990a103b3896fe249a11fe27fa28985448187f93ec12116d72") @db.Char(64)
  executionInputSchemaVersion Int         @default(1)
  state                       Json
  savedAt                     DateTime    @default(now())
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  project                     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun                 WorkflowRun @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)

  @@unique([projectId, workflowRunId, nodeId])
  @@index([projectId, updatedAt])
  @@map("workflow_node_states")
}

model WorkingArtifact {
  id               String                      @id @default(uuid()) @db.Uuid
  projectId        String                      @db.Uuid
  workflowRunId    String                      @db.Uuid
  nodeId           String                      @db.VarChar(160)
  artifactKey      String                      @db.VarChar(500)
  kind             WorkingArtifactKind
  name             String                      @db.VarChar(120)
  directory        AssetDirectory
  type             AssetType
  tags             String[]                    @default([])
  payload          Json?
  metadata         Json?
  originalFileName String?                     @db.VarChar(255)
  mimeType         String?                     @db.VarChar(120)
  sizeBytes        Int?
  storageKey       String?                     @db.VarChar(500)
  sourceRunId      String?                     @db.VarChar(255)
  sourceArtifactId String?                     @db.VarChar(255)
  revision         Int                         @default(1)
  contentHash      String                      @default("") @db.Char(64)
  freshness        WorkingArtifactFreshness    @default(CURRENT)
  availability     WorkingArtifactAvailability @default(AVAILABLE)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun      WorkflowRun                 @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  files            WorkingArtifactFile[]
  dependencies     WorkingArtifactDependency[] @relation("WorkingArtifactDependencies")
  sourceDependents WorkingArtifactDependency[] @relation("WorkingArtifactDependencySources")

  @@unique([projectId, workflowRunId, nodeId, artifactKey])
  @@unique([projectId, id])
  @@unique([projectId, workflowRunId, id])
  @@index([projectId, workflowRunId, nodeId, updatedAt])
  @@map("working_artifacts")
}

model FileObject {
  id               String                   @id @default(uuid()) @db.Uuid
  projectId        String                   @db.Uuid
  workflowRunId    String                   @db.Uuid
  nodeId           String                   @db.VarChar(160)
  originalFileName String                   @db.VarChar(255)
  mimeType         String                   @db.VarChar(120)
  sizeBytes        Int
  storageKey       String                   @db.VarChar(500)
  sha256           String                   @db.Char(64)
  status           FileObjectStatus         @default(AVAILABLE)
  orphanedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun      WorkflowRun              @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  artifactLinks    WorkingArtifactFile[]
  materials        EffectImportMaterial[]
  uploadItems      EffectImportUploadItem[]

  @@unique([projectId, storageKey])
  @@unique([projectId, id])
  @@unique([projectId, workflowRunId, id])
  @@index([projectId, workflowRunId, status, updatedAt])
  @@map("file_objects")
}

model WorkingArtifactFile {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @db.Uuid
  workflowRunId     String          @db.Uuid
  workingArtifactId String          @db.Uuid
  fileObjectId      String          @db.Uuid
  role              String          @db.VarChar(80)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  workingArtifact   WorkingArtifact @relation(fields: [projectId, workflowRunId, workingArtifactId], references: [projectId, workflowRunId, id], onDelete: Cascade)
  fileObject        FileObject      @relation(fields: [projectId, workflowRunId, fileObjectId], references: [projectId, workflowRunId, id], onDelete: Restrict)

  @@unique([projectId, workingArtifactId, fileObjectId])
  @@index([projectId, workflowRunId, workingArtifactId, sortOrder])
  @@index([projectId, fileObjectId])
  @@map("working_artifact_files")
}

model WorkingArtifactDependency {
  id                  String                              @id @default(uuid()) @db.Uuid
  projectId           String                              @db.Uuid
  workflowRunId       String                              @db.Uuid
  dependentArtifactId String                              @db.Uuid
  sourceType          WorkingArtifactDependencySourceType
  sourceNodeId        String?                             @db.VarChar(160)
  sourceArtifactId    String?                             @db.Uuid
  sourceKey           String                              @db.VarChar(500)
  sourceRevision      Int?
  sourceHash          String?                             @db.Char(64)
  createdAt           DateTime                            @default(now())
  dependentArtifact   WorkingArtifact                     @relation("WorkingArtifactDependencies", fields: [projectId, workflowRunId, dependentArtifactId], references: [projectId, workflowRunId, id], onDelete: Cascade)
  sourceArtifact      WorkingArtifact?                    @relation("WorkingArtifactDependencySources", fields: [projectId, workflowRunId, sourceArtifactId], references: [projectId, workflowRunId, id], onDelete: Restrict)

  @@unique([projectId, dependentArtifactId, sourceType, sourceKey])
  @@index([projectId, workflowRunId, sourceType, sourceKey])
  @@index([projectId, sourceArtifactId])
  @@map("working_artifact_dependencies")
}

model AssetVersion {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  assetId          String      @db.Uuid
  version          Int
  changeNote       String      @db.VarChar(2000)
  status           AssetStatus
  qualityStatus    AssetStatus
  content          Json?
  businessData     Json?
  originalFileName String      @db.VarChar(255)
  mimeType         String      @db.VarChar(120)
  sizeBytes        Int
  storageKey       String      @db.VarChar(500)
  createdAt        DateTime    @default(now())
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  asset            Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([projectId, assetId, version])
  @@index([projectId, assetId, createdAt])
  @@map("asset_versions")
}

model AssetOperationReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  operationKey   String   @db.VarChar(500)
  assetId        String   @db.Uuid
  assetVersionId String   @db.Uuid
  version        Int
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, operationKey])
  @@index([projectId, assetId])
  @@map("asset_operation_receipts")
}

model EffectImportWorkspace {
  id            String              @id @default(uuid()) @db.Uuid
  projectId     String              @unique @db.Uuid
  workflowRunId String              @unique @db.Uuid
  currentMode   EffectImportMode    @default(SINGLE)
  revision      Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun         @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  drafts        EffectImportDraft[]

  @@unique([projectId, id])
  @@unique([projectId, workflowRunId])
  @@map("effect_import_workspaces")
}

model EffectImportDraft {
  id                String                      @id @default(uuid()) @db.Uuid
  projectId         String                      @db.Uuid
  workspaceId       String                      @db.Uuid
  mode              EffectImportMode
  status            EffectImportDraftStatus     @default(DRAFT)
  globalConfig      Json
  revision          Int                         @default(1)
  validatedRevision Int?
  validationIssues  Json
  validatedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workspace         EffectImportWorkspace       @relation(fields: [projectId, workspaceId], references: [projectId, id], onDelete: Cascade)
  products          EffectImportProduct[]
  manifestImports   EffectManifestImport[]
  extractionRuns    EffectExtractionRun[]
  extractionResults EffectExtractionResult[]
  uploadSessions    EffectImportUploadSession[]

  @@unique([projectId, mode])
  @@unique([projectId, id])
  @@index([projectId, updatedAt])
  @@map("effect_import_drafts")
}

model EffectImportProduct {
  id                      String                      @id @default(uuid()) @db.Uuid
  projectId               String                      @db.Uuid
  workflowRunId           String                      @db.Uuid
  draftId                 String                      @db.Uuid
  status                  EffectImportProductStatus   @default(ACTIVE)
  removedAt               DateTime?
  purgeAfter              DateTime?
  name                    String                      @default("") @db.VarChar(120)
  category                String                      @default("") @db.VarChar(120)
  sku                     String                      @default("") @db.VarChar(160)
  normalizedSku           String                      @default("") @db.VarChar(160)
  commerceUrl             String?                     @db.VarChar(2000)
  configOverride          Json
  sortOrder               Int                         @default(0)
  sourceManifestImportId  String?                     @db.Uuid
  sourceManifestRowNumber Int?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  draft                   EffectImportDraft           @relation(fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade)
  workflowRun             WorkflowRun                 @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  sourceManifestImport    EffectManifestImport?       @relation(fields: [projectId, sourceManifestImportId], references: [projectId, id], onDelete: Restrict)
  materials               EffectImportMaterial[]
  extractionRuns          EffectExtractionRun[]
  extractionResults       EffectExtractionResult[]
  promptRuns              EffectPromptRun[]
  promptResults           EffectPromptResult[]
  uploadSessions          EffectImportUploadSession[]

  @@unique([projectId, id])
  @@unique([projectId, workflowRunId, id])
  @@index([projectId, workflowRunId, status, purgeAfter])
  @@index([projectId, draftId, sortOrder])
  @@index([projectId, draftId, normalizedSku])
  @@map("effect_import_products")
}

model EffectImportMaterial {
  id                 String                          @id @default(uuid()) @db.Uuid
  projectId          String                          @db.Uuid
  workflowRunId      String                          @db.Uuid
  productId          String                          @db.Uuid
  type               EffectImportMaterialType
  status             EffectImportMaterialStatus      @default(UPLOADING)
  expectedFileName   String?                         @db.VarChar(255)
  originalFileName   String?                         @db.VarChar(255)
  mimeType           String?                         @db.VarChar(120)
  sizeBytes          Int?
  storageKey         String?                         @db.VarChar(500)
  fileObjectId       String?                         @db.Uuid
  failureDisposition EffectImportFailureDisposition?
  errorCode          String?                         @db.VarChar(120)
  errorMessage       String?                         @db.VarChar(500)
  retryCount         Int                             @default(0)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  product            EffectImportProduct             @relation(fields: [projectId, productId], references: [projectId, id], onDelete: Cascade)
  workflowRun        WorkflowRun                     @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  fileObject         FileObject?                     @relation(fields: [projectId, workflowRunId, fileObjectId], references: [projectId, workflowRunId, id], onDelete: Restrict)

  @@unique([projectId, id])
  @@index([projectId, productId, type])
  @@index([projectId, fileObjectId])
  @@map("effect_import_materials")
}

model EffectImportUploadSession {
  id               String                          @id @default(uuid()) @db.Uuid
  projectId        String                          @db.Uuid
  workflowRunId    String                          @db.Uuid
  draftId          String                          @db.Uuid
  productId        String                          @db.Uuid
  expectedRevision Int
  status           EffectImportUploadSessionStatus @default(UPLOADING)
  completionKey    String?                         @db.VarChar(500)
  expiresAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  project          Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowRun      WorkflowRun                     @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  draft            EffectImportDraft               @relation(fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade)
  product          EffectImportProduct             @relation(fields: [projectId, productId], references: [projectId, id], onDelete: Cascade)
  items            EffectImportUploadItem[]

  @@unique([projectId, id])
  @@unique([projectId, workflowRunId, id])
  @@unique([projectId, completionKey])
  @@index([projectId, productId, status, expiresAt])
  @@map("effect_import_upload_sessions")
}

model EffectImportUploadItem {
  id               String                       @id @default(uuid()) @db.Uuid
  projectId        String                       @db.Uuid
  workflowRunId    String                       @db.Uuid
  sessionId        String                       @db.Uuid
  clientFileId     String                       @db.VarChar(160)
  type             EffectImportMaterialType
  expectedFileName String?                      @db.VarChar(255)
  status           EffectImportUploadItemStatus @default(PENDING)
  originalFileName String                       @db.VarChar(255)
  mimeType         String                       @db.VarChar(120)
  sizeBytes        Int
  storageKey       String?                      @db.VarChar(500)
  sha256           String?                      @db.Char(64)
  fileObjectId     String?                      @db.Uuid
  errorCode        String?                      @db.VarChar(120)
  errorMessage     String?                      @db.VarChar(500)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  session          EffectImportUploadSession    @relation(fields: [projectId, workflowRunId, sessionId], references: [projectId, workflowRunId, id], onDelete: Cascade)
  workflowRun      WorkflowRun                  @relation(fields: [projectId, workflowRunId], references: [projectId, id], onDelete: Cascade)
  fileObject       FileObject?                  @relation(fields: [projectId, workflowRunId, fileObjectId], references: [projectId, workflowRunId, id], onDelete: Restrict)

  @@unique([projectId, sessionId, clientFileId])
  @@index([projectId, fileObjectId])
  @@map("effect_import_upload_items")
}

model EffectManifestImport {
  id                   String                     @id @default(uuid()) @db.Uuid
  projectId            String                     @db.Uuid
  draftId              String                     @db.Uuid
  status               EffectManifestImportStatus @default(PREVIEW)
  format               EffectManifestFormat
  originalFileName     String                     @db.VarChar(255)
  rowCount             Int
  previewRows          Json
  issues               Json
  idempotencyKey       String?                    @db.VarChar(500)
  commitIdempotencyKey String?                    @db.VarChar(500)
  expiresAt            DateTime
  committedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  draft                EffectImportDraft          @relation(fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade)
  stagedFiles          EffectManifestStagedFile[]
  products             EffectImportProduct[]

  @@unique([projectId, id])
  @@unique([projectId, draftId, idempotencyKey])
  @@index([projectId, draftId, status, expiresAt])
  @@map("effect_manifest_imports")
}

model StorageCleanupTask {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  storageKey    String   @db.VarChar(500)
  reason        String   @db.VarChar(120)
  attempts      Int      @default(0)
  lastError     String?  @db.VarChar(500)
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, storageKey])
  @@index([projectId, nextAttemptAt])
  @@map("storage_cleanup_tasks")
}

model EffectManifestStagedFile {
  id                  String                        @id @default(uuid()) @db.Uuid
  projectId           String                        @db.Uuid
  manifestImportId    String                        @db.Uuid
  originalFileName    String                        @db.VarChar(255)
  mimeType            String                        @db.VarChar(120)
  sizeBytes           Int
  storageKey          String                        @db.VarChar(500)
  matchedRowNumbers   Int[]                         @default([])
  matchedMaterialType EffectImportMaterialType?
  matchStatus         EffectManifestFileMatchStatus
  transferredAt       DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  manifestImport      EffectManifestImport          @relation(fields: [projectId, manifestImportId], references: [projectId, id], onDelete: Cascade)

  @@unique([projectId, id])
