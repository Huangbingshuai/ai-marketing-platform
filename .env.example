APP_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=

# local / tos
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=
MAX_UPLOAD_BYTES=536870912
WORKING_FILE_CLEANUP_GRACE_HOURS=24

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing?schema=public
REDIS_URL=redis://localhost:6379
# Disposable API projections; reads still validate their PostgreSQL dependency versions.
EFFECT_READ_CACHE_ENABLED=true
EFFECT_READ_CACHE_LOG_METRICS=false
EFFECT_READ_CACHE_TIMEOUT_MS=150
EFFECT_READ_CACHE_TTL_SECONDS=1800
EFFECT_READ_CACHE_MAX_BYTES=2097152
# 0 caches all audited projections; set a positive threshold only after measuring a regression.
EFFECT_READ_CACHE_MIN_LOAD_MS=0
EFFECT_READ_CACHE_NAMESPACE=amp:effect-read:v1
REDIS_MAXMEMORY=256mb
RABBITMQ_URL=amqp://guest:guest@localhost:5672
CUSTOMIZED_EXTRACTION_WORKER_TOKEN=replace-with-a-customized-extraction-worker-secret
CUSTOMIZED_STORYBOARD_WORKER_TOKEN=replace-with-a-customized-storyboard-worker-secret
CUSTOMIZED_ASSETS_WORKER_TOKEN=replace-with-a-customized-assets-worker-secret
CUSTOMIZED_PRODUCTION_WORKER_TOKEN=replace-with-a-customized-production-worker-secret
CUSTOMIZED_STORYBOARD_CREATIVE_MODEL=doubao-seed-2-1-pro-260915
CUSTOMIZED_STORYBOARD_DETAIL_MODEL=doubao-seed-2-1-turbo-260628
CUSTOMIZED_STORYBOARD_CONCURRENCY=2
CUSTOMIZED_STORYBOARD_TIMEOUT_SECONDS=300
CUSTOMIZED_STORYBOARD_MAX_ATTEMPTS=2
EFFECT_EXTRACTION_WORKER_TOKEN=replace-with-a-long-random-worker-secret
EFFECT_PROMPT_WORKER_TOKEN=replace-with-a-different-long-random-worker-secret
EFFECT_SEGMENT_RENDER_WORKER_TOKEN=replace-with-another-long-random-worker-secret
EFFECT_TEMPLATE_MIX_WORKER_TOKEN=replace-with-a-template-mix-worker-secret

# AI 信息提炼 Worker（Docker 容器访问宿主 Nest API）
INTERNAL_API_BASE_URL=http://host.docker.internal:3000/api
EFFECT_EXTRACTION_QUEUE=effect.extraction.requested
EXTRACTION_AI_PROVIDER=ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=replace-with-your-ark-api-key
# 通用回退模型；支持已授权 Model ID 或 ep- Endpoint ID
ARK_MODEL=doubao-seed-2-1-turbo-260628
ARK_TEMPLATE_MIX_MODEL=
ARK_VIDEO_IMPORT_MODEL=doubao-seed-2-1-pro-260628
ARK_TEMPLATE_MIX_MAX_OUTPUT_TOKENS=8192
ARK_TEMPLATE_MIX_REASONING_EFFORT=minimal
TEMPLATE_MIX_CLASSIFICATION_BATCH_SIZE=10
TEMPLATE_MIX_CLASSIFICATION_INPUT_TOKEN_BUDGET=16000
TEMPLATE_MIX_AI_MAX_CONCURRENCY=4
# Internal API transport recovery only; no blind replay of paid model requests.
TEMPLATE_MIX_API_RECOVERY_MAX_ATTEMPTS=20
TEMPLATE_MIX_API_RECOVERY_TIMEOUT_SECONDS=600
TEMPLATE_MIX_API_RECOVERY_MAX_DELAY_SECONDS=30
TEMPLATE_MIX_PACKAGING_ITEM_CONCURRENCY=6
TEMPLATE_MIX_PACKAGING_MODEL_CONCURRENCY=4
TEMPLATE_MIX_PACKAGING_MODEL_TIMEOUT_SECONDS=300
TEMPLATE_MIX_PACKAGING_MODEL_MAX_OUTPUT_TOKENS=16384
TEMPLATE_MIX_PACKAGING_TTS_CONCURRENCY=4
TEMPLATE_MIX_PACKAGING_TTS_CONNECTION_MAX_ATTEMPTS=8
TEMPLATE_MIX_PACKAGING_TTS_CONNECTION_TIMEOUT_SECONDS=600
TEMPLATE_MIX_PACKAGING_TTS_CONNECTION_MAX_DELAY_SECONDS=30
TEMPLATE_MIX_PACKAGING_ITEM_TIMEOUT_SECONDS=2400
TEMPLATE_MIX_PACKAGING_STEP_RETRY_ATTEMPTS=2
VOLC_TTS_API_KEY=
VOLC_TTS_SPEAKER=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# API-only curated catalog JSON. Omit to use the previously verified Vivi default.
# Only enable voices verified on the configured TTS account; [] explicitly disables the catalog.
# Each entry: id,name,gender(FEMALE/MALE),description,version,speaker,resourceId,enabled,verifiedAt(ISO date).
# Change version after reauthorization or provider resource changes. No credentials in this JSON.
# TEMPLATE_MIX_VOICE_CATALOG_JSON=[]
VOLC_MUSIC_ACCESS_KEY=
VOLC_MUSIC_SECRET_KEY=
VOLC_MUSIC_ACTION=GenBGMForTime
# 可选分节点模型；留空时回退到 ARK_MODEL
ARK_DOCUMENT_MODEL=doubao-seed-2-1-pro-260628
ARK_DOCUMENT_TIMEOUT_SECONDS=180
ARK_DOCUMENT_MAX_ATTEMPTS=1
ARK_DOCUMENT_MAX_OUTPUT_TOKENS=8192
ARK_DOCUMENT_REASONING_EFFORT=minimal
# 定制类独立审校预算，不影响效果类提炼
CUSTOMIZED_EXTRACTION_REASONING_EFFORT=medium
CUSTOMIZED_EXTRACTION_MAX_ATTEMPTS=2
CUSTOMIZED_EXTRACTION_AUDIT_REASONING_EFFORT=low
CUSTOMIZED_EXTRACTION_DOCUMENT_REASONING_EFFORT=low
CUSTOMIZED_EXTRACTION_MODEL_TIMEOUT_SECONDS=300
CUSTOMIZED_EXTRACTION_MAX_OUTPUT_TOKENS=16384
CUSTOMIZED_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=32768
DOCUMENT_CHUNK_TEXT_CHARS=12000
DOCUMENT_MAX_CONCURRENCY=2
ARK_IMAGE_MODEL=
# 图片识别专用预算：低细节输入、紧凑输出和两次有限尝试控制尾延迟
ARK_IMAGE_DETAIL=low
ARK_IMAGE_REASONING_EFFORT=minimal
ARK_IMAGE_ADAPTIVE_HIGH_DETAIL=true
ARK_IMAGE_TIMEOUT_SECONDS=90
ARK_IMAGE_MAX_ATTEMPTS=2
ARK_IMAGE_MAX_OUTPUT_TOKENS=4096
ARK_IMAGE_RETRY_MAX_OUTPUT_TOKENS=6144
IMAGE_MAX_DIMENSION=1280
IMAGE_MAX_CONCURRENCY=2
ARK_COMMERCE_MODEL=
ARK_SEMANTIC_MODEL=doubao-seed-2-1-pro-260628
ARK_SEMANTIC_TIMEOUT_SECONDS=30
ARK_SEMANTIC_MAX_ATTEMPTS=1
ARK_SEMANTIC_MAX_OUTPUT_TOKENS=3072
ARK_SEMANTIC_REASONING_EFFORT=minimal
ARK_SEMANTIC_USER_REVIEW_REASONING_EFFORT=minimal
ARK_NORMALIZATION_MODEL=
COMMERCE_RENDERER_MAX_CONCURRENCY=2
COMMERCE_RENDERER_TIMEOUT_SECONDS=25
COMMERCE_RENDERER_MAX_DOM_BYTES=2097152
COMMERCE_RENDERER_SETTLE_MILLISECONDS=750
DOCLING_ARTIFACTS_PATH=/models
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4

# 效果类差异化 Prompt Worker（独立队列与独立内部 Token）
EFFECT_PROMPT_QUEUE=effect.prompt-generation.requested
PROMPT_AI_PROVIDER=ark
# 旧版兼容覆盖；新部署优先使用下面的分阶段配置
ARK_PROMPT_MODEL=
# 留空时营销关系、坐标和蓝图规划安全默认 doubao-seed-2-0-lite-260428；候选节点回退 ARK_PROMPT_MODEL/ARK_MODEL
ARK_PROMPT_STRATEGY_MODEL=
ARK_PROMPT_VISUAL_STRATEGY_MODEL=
ARK_PROMPT_VISUAL_STRATEGY_IMAGE_DETAIL=high
PROMPT_VISUAL_REFERENCE_MAX_INPUT_BYTES=20971520
PROMPT_VISUAL_REFERENCE_MAX_DIMENSION=1280
PROMPT_VISUAL_REFERENCE_MAX_OUTPUT_BYTES=4194304
ARK_PROMPT_FRAGMENT_STRATEGY_MODEL=
ARK_PROMPT_BLUEPRINT_MODEL=
ARK_PROMPT_CANDIDATE_MODEL=
# 当前 Prompt 向量语义择优。模型值必须显式配置为已开通的 Model ID 或 Endpoint ID。
PROMPT_SIMILARITY_MODE=vector
ARK_PROMPT_EMBEDDING_MODEL=doubao-embedding-vision-251215
ARK_PROMPT_EMBEDDING_API_MODE=multimodal
ARK_PROMPT_EMBEDDING_TIMEOUT_SECONDS=30
ARK_PROMPT_EMBEDDING_MAX_ATTEMPTS=3
PROMPT_EMBEDDING_BATCH_SIZE=64
PROMPT_EMBEDDING_MAX_CONCURRENCY=8
ARK_PROMPT_STRATEGY_MAX_OUTPUT_TOKENS=8192
ARK_PROMPT_FRAGMENT_STRATEGY_MAX_OUTPUT_TOKENS=3072
ARK_PROMPT_CANDIDATE_MAX_OUTPUT_TOKENS=8192
ARK_PROMPT_EVALUATION_MAX_OUTPUT_TOKENS=8192
# 评估分片的本地输入规划预算；不会作为 Ark 模型上下文上限发送
PROMPT_EVALUATION_INPUT_TOKEN_BUDGET=12000
ARK_PROMPT_REASONING_EFFORT=minimal
PROMPT_MAX_CONCURRENCY=4
PROMPT_SHARD_SIZE=8
# V10 异常循环熔断；默认 50 条正常调用为 30 次，该值不是常规预算
PROMPT_MAX_AI_CALLS_PER_RUN=256
INTERNAL_API_TIMEOUT_SECONDS=60
# 旧版兼容：未设置候选专用超时时继续作为候选生成超时
ARK_TIMEOUT_SECONDS=120
ARK_PROMPT_STRATEGY_TIMEOUT_SECONDS=180
ARK_PROMPT_DIRECTION_REVIEW_TIMEOUT_SECONDS=180
PROMPT_DIRECTION_REVIEW_BATCH_SIZE=6
PROMPT_DIRECTION_REVIEW_INPUT_BUDGET=12000
ARK_PROMPT_FRAGMENT_STRATEGY_TIMEOUT_SECONDS=120
ARK_PROMPT_CANDIDATE_TIMEOUT_SECONDS=120
# 瞬时网络/限流/服务错误在单次 Provider 调用内最多尝试 3 次；业务 Run 仍保留最多 3 次恢复
ARK_PROMPT_PROVIDER_MAX_ATTEMPTS=3

# TOS 外网原生地域 Endpoint 或 S3 Endpoint（不填 Bucket 域名）。
# 例如 tos-cn-beijing.volces.com；通过官方 SDK 直连 HTTPS 原生地域地址。
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=

SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL=
SEEDANCE_MODEL_2_5=doubao-seedance-2-5-260628
SEEDANCE_MODEL_2_0=doubao-seedance-2-0-260128
SEEDANCE_MODEL_2_0_MINI=doubao-seedance-2-0-mini-260615
SEEDANCE_MODEL_2_0_FAST=doubao-seedance-2-0-fast-260128
SEGMENT_RENDER_PROVIDER=ark
SEEDANCE_TIMEOUT_SECONDS=900
SEEDANCE_POLL_INTERVAL_SECONDS=8
SEGMENT_RENDER_MAX_INFLIGHT=20
SEGMENT_RENDER_CREATE_QPS=3
SEGMENT_RENDER_DOWNLOAD_CONCURRENCY=3
SEGMENT_RENDER_REFERENCE_CACHE_BYTES=134217728
SEEDANCE_REFERENCE_PUBLIC_BASE_URL=
SEEDANCE_REFERENCE_SIGNING_SECRET=
