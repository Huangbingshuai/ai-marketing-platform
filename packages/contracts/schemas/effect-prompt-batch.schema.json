{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-marketing.local/schemas/effect-prompt-batch.v2.json",
  "title": "EffectPromptBatchResult.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "settings", "items", "metrics", "qualityStatus"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "durationSeconds",
        "semanticLimit",
        "visualLimit",
        "styleOverride",
        "fragmentTypeWeights",
        "sellingPointWeights",
        "additionalDisabledElements"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 10, "maximum": 200 },
        "durationSeconds": { "type": "integer", "minimum": 3, "maximum": 10 },
        "semanticLimit": { "type": "integer", "minimum": 5, "maximum": 15 },
        "visualLimit": { "type": "integer", "minimum": 10, "maximum": 20 },
        "styleOverride": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        },
        "fragmentTypeWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HOOK",
            "PAIN",
            "PRODUCT_DISPLAY",
            "EFFECT_DEMONSTRATION",
            "SELLING_POINT_EXPLANATION",
            "CTA",
            "OUTRO"
          ],
          "properties": {
            "HOOK": { "type": "integer", "minimum": 0, "maximum": 100 },
            "PAIN": { "type": "integer", "minimum": 0, "maximum": 100 },
            "PRODUCT_DISPLAY": { "type": "integer", "minimum": 0, "maximum": 100 },
            "EFFECT_DEMONSTRATION": { "type": "integer", "minimum": 0, "maximum": 100 },
            "SELLING_POINT_EXPLANATION": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "CTA": { "type": "integer", "minimum": 0, "maximum": 100 },
            "OUTRO": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "sellingPointWeights": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sellingPoint", "weight"],
            "properties": {
              "sellingPoint": { "type": "string", "minLength": 1, "maxLength": 240 },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          }
        },
        "additionalDisabledElements": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/item" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCount",
        "acceptedCount",
        "generatedCandidateCount",
        "removedSemanticDuplicates",
        "removedVisualDuplicates",
        "removedDimensionConflicts",
        "removedExecutionInvalid",
        "semanticDuplicateRate",
        "visualOverlapRate",
        "replenishmentRounds",
        "fragmentTypeDistribution",
        "sellingPointCoverage",
        "executionInvalidReasons"
      ],
      "properties": {
        "targetCount": { "type": "integer", "minimum": 10, "maximum": 200 },
        "acceptedCount": { "type": "integer", "minimum": 0, "maximum": 200 },
        "generatedCandidateCount": { "type": "integer", "minimum": 0 },
        "removedSemanticDuplicates": { "type": "integer", "minimum": 0 },
        "removedVisualDuplicates": { "type": "integer", "minimum": 0 },
        "removedDimensionConflicts": { "type": "integer", "minimum": 0 },
        "removedExecutionInvalid": { "type": "integer", "minimum": 0 },
        "semanticDuplicateRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "visualOverlapRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "replenishmentRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
        "fragmentTypeDistribution": {
          "$ref": "#/$defs/fragmentTypeDistribution"
        },
        "sellingPointCoverage": { "$ref": "#/$defs/sellingPointCoverage" },
        "executionInvalidReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "count"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 120 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "qualityStatus": { "enum": ["PASS", "NEEDS_REVIEW"] }
  },
  "$defs": {
    "fragmentType": {
      "type": "string",
      "enum": [
        "HOOK",
        "PAIN",
        "PRODUCT_DISPLAY",
        "EFFECT_DEMONSTRATION",
        "SELLING_POINT_EXPLANATION",
        "CTA",
        "OUTRO"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "scene", "persona", "sellingPoint", "camera", "emotion"],
      "properties": {
        "narrative": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scene": { "type": "string", "minLength": 1, "maxLength": 120 },
        "persona": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sellingPoint": { "type": "string", "minLength": 1, "maxLength": 240 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 160 },
        "emotion": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "origin",
        "fragmentType",
        "materialTags",
        "targetDurationSeconds",
        "dimensions",
        "content",
        "manualEdited",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "origin": { "enum": ["AI", "MANUAL"] },
        "fragmentType": { "$ref": "#/$defs/fragmentType" },
        "materialTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "targetDurationSeconds": { "type": "integer", "minimum": 3, "maximum": 10 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "content": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "manualEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "fragmentTypeDistribution": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragmentType", "targetCount", "actualCount"],
        "properties": {
          "fragmentType": { "$ref": "#/$defs/fragmentType" },
          "targetCount": { "type": "integer", "minimum": 0, "maximum": 200 },
          "actualCount": { "type": "integer", "minimum": 0, "maximum": 200 }
        }
      }
    },
    "sellingPointCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "covered", "missing"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "covered": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  }
}
