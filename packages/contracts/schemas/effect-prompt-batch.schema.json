{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-marketing.local/schemas/effect-prompt-batch.v5.json",
  "title": "EffectPromptBatchResult.v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "settings", "renderProfile", "items", "metrics", "qualityStatus"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragmentConfigs", "semanticLimit", "visualLimit"],
      "properties": {
        "fragmentConfigs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HOOK",
            "PAIN",
            "PRODUCT_DISPLAY",
            "SELLING_POINT_EXPLANATION",
            "CTA",
            "OUTRO"
          ],
          "properties": {
            "HOOK": { "$ref": "#/$defs/fragmentConfig" },
            "PAIN": { "$ref": "#/$defs/fragmentConfig" },
            "PRODUCT_DISPLAY": { "$ref": "#/$defs/fragmentConfig" },
            "SELLING_POINT_EXPLANATION": { "$ref": "#/$defs/fragmentConfig" },
            "CTA": { "$ref": "#/$defs/fragmentConfig" },
            "OUTRO": { "$ref": "#/$defs/fragmentConfig" }
          }
        },
        "semanticLimit": { "type": "integer", "minimum": 5, "maximum": 15 },
        "visualLimit": { "type": "integer", "minimum": 10, "maximum": 20 }
      }
    },
    "renderProfile": { "$ref": "#/$defs/renderProfile" },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/item" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCount",
        "acceptedCount",
        "generatedCandidateCount",
        "fallbackCount",
        "removedSemanticDuplicates",
        "removedVisualDuplicates",
        "removedDimensionConflicts",
        "removedExecutionInvalid",
        "semanticDuplicateRate",
        "visualOverlapRate",
        "replenishmentRounds",
        "fragmentTypeDistribution",
        "sellingPointCoverage",
        "insightCoverage",
        "executionInvalidReasons"
      ],
      "properties": {
        "targetCount": { "type": "integer", "minimum": 10, "maximum": 200 },
        "acceptedCount": { "type": "integer", "minimum": 0, "maximum": 200 },
        "generatedCandidateCount": { "type": "integer", "minimum": 0 },
        "fallbackCount": { "type": "integer", "minimum": 0, "maximum": 200 },
        "removedSemanticDuplicates": { "type": "integer", "minimum": 0 },
        "removedVisualDuplicates": { "type": "integer", "minimum": 0 },
        "removedDimensionConflicts": { "type": "integer", "minimum": 0 },
        "removedExecutionInvalid": { "type": "integer", "minimum": 0 },
        "semanticDuplicateRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "visualOverlapRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "replenishmentRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
        "fragmentTypeDistribution": {
          "$ref": "#/$defs/fragmentTypeDistribution"
        },
        "sellingPointCoverage": { "$ref": "#/$defs/sellingPointCoverage" },
        "insightCoverage": { "$ref": "#/$defs/insightCoverage" },
        "executionInvalidReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "count"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 120 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "qualityStatus": { "enum": ["PASS", "NEEDS_REVIEW"] }
  },
  "$defs": {
    "fragmentType": {
      "type": "string",
      "enum": ["HOOK", "PAIN", "PRODUCT_DISPLAY", "SELLING_POINT_EXPLANATION", "CTA", "OUTRO"]
    },
    "fragmentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "durationSeconds"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 200 },
        "durationSeconds": { "type": "integer", "minimum": 4, "maximum": 15 }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "scene", "persona", "sellingPoint", "camera", "emotion"],
      "properties": {
        "narrative": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scene": { "type": "string", "minLength": 1, "maxLength": 120 },
        "persona": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sellingPoint": { "type": "string", "minLength": 1, "maxLength": 240 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 160 },
        "emotion": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "origin",
        "fragmentType",
        "materialTags",
        "targetDurationSeconds",
        "dimensions",
        "content",
        "insightBindings",
        "manualEdited",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "origin": { "enum": ["AI", "MANUAL"] },
        "fragmentType": { "$ref": "#/$defs/fragmentType" },
        "materialTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "targetDurationSeconds": { "type": "integer", "minimum": 4, "maximum": 15 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "content": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "insightBindings": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/insightBinding" }
        },
        "manualEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "renderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "resolution", "capabilityKey", "sharedConstraints"],
      "properties": {
        "ratio": { "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "21:9", "adaptive"] },
        "resolution": { "enum": ["480p", "720p", "1080p"] },
        "capabilityKey": {
          "enum": ["SEEDANCE_2_0", "SEEDANCE_2_0_FAST", "SEEDANCE_1_5_PRO", "SEEDANCE_1_0"]
        },
        "sharedConstraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disabledElements", "contentHash"],
          "properties": {
            "disabledElements": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "fragmentTypeDistribution": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragmentType", "targetCount", "actualCount"],
        "properties": {
          "fragmentType": { "$ref": "#/$defs/fragmentType" },
          "targetCount": { "type": "integer", "minimum": 0, "maximum": 200 },
          "actualCount": { "type": "integer", "minimum": 0, "maximum": 200 }
        }
      }
    },
    "sellingPointCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "covered", "missing"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "covered": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "insightField": {
      "type": "string",
      "enum": [
        "PRODUCT_NAME",
        "PRODUCT_CATEGORY",
        "CORE_SPECIFICATION",
        "PRICE_RANGE",
        "VISUAL_FEATURES",
        "CORE_SELLING_POINT",
        "SECONDARY_SELLING_POINT",
        "TRUST_BACKING",
        "TARGET_AUDIENCE",
        "CORE_PAIN_POINT",
        "DECISION_DRIVER",
        "MARKETING_GOAL",
        "USAGE_SCENARIO",
        "PURCHASE_SCENARIO",
        "EMOTIONAL_SCENARIO",
        "SOURCE_DURATION",
        "ASPECT_RATIO",
        "DELIVERY_CHANNELS",
        "DISABLED_ELEMENT",
        "VISUAL_STYLE_BASELINE"
      ]
    },
    "insightReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "field", "value", "valueHash"],
      "properties": {
        "factId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "field": { "$ref": "#/$defs/insightField" },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "valueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "insightBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "field", "value", "valueHash", "role"],
      "properties": {
        "factId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "field": { "$ref": "#/$defs/insightField" },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "valueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "enum": ["PRIMARY", "CONTEXT", "EVIDENCE"] }
      }
    },
    "excludedInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factId", "field", "value", "valueHash", "reason"],
      "properties": {
        "factId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "field": { "$ref": "#/$defs/insightField" },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "valueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "enum": ["UNCERTAIN", "EMPTY", "UNSUPPORTED"] }
      }
    },
    "insightCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "covered",
        "missing",
        "adaptive",
        "deferred",
        "excluded",
        "appliedConstraints"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        },
        "covered": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        },
        "adaptive": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        },
        "deferred": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/excludedInsight" }
        },
        "appliedConstraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/insightReference" }
        }
      }
    }
  }
}
