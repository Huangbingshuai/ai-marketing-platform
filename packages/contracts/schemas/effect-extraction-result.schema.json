{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-marketing.local/schemas/effect-extraction-result.schema.json",
  "title": "EffectExtractionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productCategory",
    "productName",
    "coreSpecification",
    "priceRange",
    "visualFeatures",
    "targetAudience",
    "marketingGoal",
    "coreSellingPoints",
    "usageScenarios",
    "deliveryChannels",
    "brandTone",
    "disabledElements"
  ],
  "properties": {
    "productCategory": { "type": "string", "maxLength": 500 },
    "productName": { "type": "string", "maxLength": 500 },
    "coreSpecification": { "type": "string", "maxLength": 2000 },
    "priceRange": { "type": "string", "maxLength": 1000 },
    "visualFeatures": { "type": "string", "maxLength": 4000 },
    "targetAudience": { "type": "string", "maxLength": 4000 },
    "marketingGoal": { "type": "string", "maxLength": 4000 },
    "coreSellingPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "usageScenarios": { "type": "string", "maxLength": 4000 },
    "deliveryChannels": { "type": "string", "maxLength": 2000 },
    "brandTone": { "type": "string", "maxLength": 2000 },
    "disabledElements": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
