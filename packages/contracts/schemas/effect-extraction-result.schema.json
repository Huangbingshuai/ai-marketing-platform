{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-marketing.local/schemas/effect-extraction-result.schema.json",
  "title": "EffectExtractionResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productCategory",
    "productName",
    "coreSpecification",
    "priceRange",
    "visualFeatures",
    "coreSellingPoints",
    "secondarySellingPoints",
    "trustBackings",
    "targetAudience",
    "corePainPoints",
    "decisionDrivers",
    "marketingGoal",
    "usageScenarios",
    "purchaseScenarios",
    "emotionalScenarios",
    "durationSeconds",
    "aspectRatio",
    "deliveryChannels",
    "disabledElements",
    "visualStyleBaseline"
  ],
  "properties": {
    "productCategory": { "type": "string", "maxLength": 500 },
    "productName": { "type": "string", "maxLength": 500 },
    "coreSpecification": { "type": "string", "maxLength": 2000 },
    "priceRange": { "type": "string", "maxLength": 1000 },
    "visualFeatures": { "type": "string", "maxLength": 4000 },
    "coreSellingPoints": { "$ref": "#/$defs/corePoints" },
    "secondarySellingPoints": { "$ref": "#/$defs/sixItems" },
    "trustBackings": { "$ref": "#/$defs/sixItems" },
    "targetAudience": { "type": "string", "maxLength": 4000 },
    "corePainPoints": { "$ref": "#/$defs/fiveItems" },
    "decisionDrivers": { "$ref": "#/$defs/fiveItems" },
    "marketingGoal": { "type": "string", "maxLength": 4000 },
    "usageScenarios": { "$ref": "#/$defs/fiveItems" },
    "purchaseScenarios": { "$ref": "#/$defs/fiveItems" },
    "emotionalScenarios": { "$ref": "#/$defs/fiveItems" },
    "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "aspectRatio": { "type": "string", "minLength": 1, "maxLength": 50 },
    "deliveryChannels": { "type": "string", "maxLength": 2000 },
    "disabledElements": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "visualStyleBaseline": { "type": "string", "maxLength": 4000 }
  },
  "$defs": {
    "corePoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "sixItems": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "fiveItems": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
