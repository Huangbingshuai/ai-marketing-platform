        "products": {
          "$ref": "#/$defs/AssetGroup"
        },
        "scenes": {
          "$ref": "#/$defs/AssetGroup"
        }
      },
      "required": ["characters", "products", "scenes"],
      "title": "AssetRequirements",
      "type": "object"
    },
