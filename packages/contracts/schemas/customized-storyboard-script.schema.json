        "kind": {
          "enum": ["characters", "products", "scenes"],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["id", "kind", "name", "description"],
      "title": "Asset",
      "type": "object"
    },
    "AssetGroup": {
