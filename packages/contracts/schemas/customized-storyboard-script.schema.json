    "name": {
      "maxLength": 200,
      "title": "Name",
      "type": "string"
    },
    "synopsis": {
      "maxLength": 20000,
      "title": "Synopsis",
      "type": "string"
    },
    "structure": {
      "maxLength": 20000,
      "title": "Structure",
      "type": "string"
