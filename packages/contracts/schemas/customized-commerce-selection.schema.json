{
  "$defs": {
    "CommerceChoice": {
      "additionalProperties": false,
      "properties": {
        "scriptId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scriptid",
          "type": "string"
        },
        "opportunityId": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Opportunityid",
          "type": "string"
        },
        "mustPreserve": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Mustpreserve",
          "type": "array"
        }
      },
      "required": ["scriptId", "opportunityId", "mustPreserve"],
      "title": "CommerceChoice",
      "type": "object"
    },
    "CommerceEvaluation": {
      "additionalProperties": false,
      "properties": {
        "opportunityId": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Opportunityid",
          "type": "string"
        },
        "verdict": {
          "enum": ["ADVANCE", "REJECT"],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["opportunityId", "verdict", "reason"],
      "title": "CommerceEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["READY", "REWORK", "NEEDS_INFORMATION"],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "missing": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Missing",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/CommerceEvaluation"
      },
      "maxItems": 6,
      "title": "Evaluations",
      "type": "array"
    },
    "choices": {
      "items": {
        "$ref": "#/$defs/CommerceChoice"
      },
      "maxItems": 5,
      "title": "Choices",
      "type": "array"
    }
  },
  "required": ["status", "reason", "missing", "evaluations", "choices"],
  "title": "CommerceSelection",
  "type": "object"
}
