{
  "$defs": {
    "BrandCommitment": {
      "additionalProperties": false,
      "properties": {
        "scriptId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scriptid",
          "type": "string"
        },
        "ideaId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ideaid",
          "type": "string"
        },
        "approach": {
          "enum": [
            "LIFE_OBSERVATION",
            "PRODUCT_DESIGN",
            "VISUAL_EXPRESSION",
            "DOCUMENTARY",
            "OTHER"
          ],
          "title": "Approach",
          "type": "string"
        },
        "mustPreserve": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Mustpreserve",
          "type": "array"
        },
        "essentialFactIds": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Essentialfactids",
          "type": "array"
        },
        "reason": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["scriptId", "ideaId", "approach", "mustPreserve", "essentialFactIds", "reason"],
      "title": "BrandCommitment",
      "type": "object"
    },
    "BrandEvaluation": {
      "additionalProperties": false,
      "properties": {
        "ideaId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ideaid",
          "type": "string"
        },
        "attraction": {
          "maximum": 5,
          "minimum": 1,
          "title": "Attraction",
          "type": "integer"
        },
        "productConnection": {
          "maximum": 5,
          "minimum": 1,
          "title": "Productconnection",
          "type": "integer"
        },
        "clarity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Clarity",
          "type": "integer"
        },
        "distinctiveness": {
          "maximum": 5,
          "minimum": 1,
          "title": "Distinctiveness",
          "type": "integer"
        },
        "verdict": {
          "enum": ["ADVANCE", "REJECT"],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "ideaId",
        "attraction",
        "productConnection",
        "clarity",
        "distinctiveness",
        "verdict",
        "reason"
      ],
      "title": "BrandEvaluation",
      "type": "object"
    },
    "BrandPlan": {
      "additionalProperties": false,
      "properties": {
        "videoType": {
          "const": "BRAND_AD",
          "title": "Videotype",
          "type": "string"
        },
        "brandImpression": {
          "maxLength": 20000,
          "title": "Brandimpression",
          "type": "string"
        },
        "visualConcept": {
          "maxLength": 20000,
          "title": "Visualconcept",
          "type": "string"
        },
        "visualProgression": {
          "maxLength": 20000,
          "title": "Visualprogression",
          "type": "string"
        },
        "productConnection": {
          "maxLength": 20000,
          "title": "Productconnection",
          "type": "string"
        },
        "ending": {
          "maxLength": 20000,
          "title": "Ending",
          "type": "string"
        }
      },
      "required": [
        "videoType",
        "brandImpression",
        "visualConcept",
        "visualProgression",
        "productConnection",
        "ending"
      ],
      "title": "BrandPlan",
      "type": "object"
