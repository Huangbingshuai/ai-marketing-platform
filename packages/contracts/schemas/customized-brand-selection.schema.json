    "TypedConcept": {
      "additionalProperties": false,
      "properties": {
        "scriptId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scriptid",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "synopsis": {
          "maxLength": 20000,
          "title": "Synopsis",
          "type": "string"
        },
        "productFocus": {
          "maxLength": 20000,
          "title": "Productfocus",
          "type": "string"
        },
        "structure": {
          "maxLength": 20000,
          "title": "Structure",
          "type": "string"
        },
        "difference": {
          "maxLength": 20000,
          "title": "Difference",
          "type": "string"
        },
        "coreIdea": {
          "default": "",
          "maxLength": 20000,
          "title": "Coreidea",
          "type": "string"
        },
        "openingHook": {
          "default": "",
          "maxLength": 20000,
          "title": "Openinghook",
          "type": "string"
        },
        "productRole": {
          "default": "",
          "maxLength": 20000,
          "title": "Productrole",
          "type": "string"
        },
        "memoryPoint": {
          "default": "",
          "maxLength": 20000,
          "title": "Memorypoint",
          "type": "string"
        },
        "plan": {
          "discriminator": {
            "mapping": {
              "BRAND_AD": "#/$defs/BrandPlan",
              "DRAMA": "#/$defs/DramaPlan",
              "ECOMMERCE": "#/$defs/EcommercePlan",
              "LOCAL_STORE": "#/$defs/LocalStorePlan"
            },
            "propertyName": "videoType"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EcommercePlan"
            },
            {
              "$ref": "#/$defs/LocalStorePlan"
            },
            {
              "$ref": "#/$defs/BrandPlan"
            },
            {
              "$ref": "#/$defs/DramaPlan"
            }
          ],
          "title": "Plan"
        }
      },
      "required": [
        "scriptId",
        "name",
        "synopsis",
        "productFocus",
        "structure",
        "difference",
        "plan"
      ],
      "title": "TypedConcept",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["READY", "REWORK", "NEEDS_INFORMATION"],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "maxLength": 320,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "missing": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Missing",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/BrandEvaluation"
      },
      "maxItems": 8,
      "minItems": 6,
      "title": "Evaluations",
      "type": "array"
    },
    "concepts": {
      "items": {
        "$ref": "#/$defs/TypedConcept"
      },
      "maxItems": 5,
      "title": "Concepts",
      "type": "array"
    },
    "commitments": {
      "items": {
        "$ref": "#/$defs/BrandCommitment"
      },
      "maxItems": 5,
      "title": "Commitments",
      "type": "array"
    }
  },
  "required": ["status", "reason", "missing", "evaluations", "concepts", "commitments"],
  "title": "BrandSelection",
  "type": "object"
}
