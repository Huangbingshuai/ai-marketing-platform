{
  "$defs": {
    "BrandCommitment": {
      "additionalProperties": false,
      "properties": {
        "scriptId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scriptid",
          "type": "string"
        },
        "ideaId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ideaid",
          "type": "string"
        },
        "approach": {
          "enum": [
            "LIFE_OBSERVATION",
            "PRODUCT_DESIGN",
            "VISUAL_EXPRESSION",
            "DOCUMENTARY",
            "OTHER"
          ],
          "title": "Approach",
          "type": "string"
        },
        "mustPreserve": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Mustpreserve",
          "type": "array"
        },
        "essentialFactIds": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Essentialfactids",
          "type": "array"
        },
        "reason": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["scriptId", "ideaId", "approach", "mustPreserve", "essentialFactIds", "reason"],
      "title": "BrandCommitment",
      "type": "object"
    },
    "BrandEvaluation": {
      "additionalProperties": false,
      "properties": {
        "ideaId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ideaid",
          "type": "string"
        },
        "attraction": {
          "maximum": 5,
          "minimum": 1,
          "title": "Attraction",
          "type": "integer"
        },
        "productConnection": {
          "maximum": 5,
          "minimum": 1,
          "title": "Productconnection",
          "type": "integer"
        },
        "clarity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Clarity",
          "type": "integer"
        },
        "distinctiveness": {
          "maximum": 5,
          "minimum": 1,
          "title": "Distinctiveness",
          "type": "integer"
        },
        "verdict": {
          "enum": ["ADVANCE", "REJECT"],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "ideaId",
        "attraction",
        "productConnection",
        "clarity",
        "distinctiveness",
        "verdict",
        "reason"
      ],
      "title": "BrandEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["READY", "REWORK", "NEEDS_INFORMATION"],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "maxLength": 320,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "missing": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Missing",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/BrandEvaluation"
      },
      "maxItems": 8,
      "minItems": 6,
      "title": "Evaluations",
      "type": "array"
    },
    "commitments": {
      "items": {
        "$ref": "#/$defs/BrandCommitment"
      },
      "maxItems": 5,
      "title": "Commitments",
      "type": "array"
    }
  },
  "required": ["status", "reason", "missing", "evaluations", "commitments"],
  "title": "LeanBrandSelection",
  "type": "object"
}
